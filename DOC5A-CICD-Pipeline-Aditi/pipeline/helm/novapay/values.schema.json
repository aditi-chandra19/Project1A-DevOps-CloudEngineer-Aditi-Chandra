{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["activeColor", "images", "replicaCount", "resources", "service"],
  "properties": {
    "activeColor": { "type": "string", "enum": ["blue", "green"] },
    "replicaCount": { "type": "integer", "minimum": 2 },
    "images": {
      "type": "object",
      "required": ["blue", "green"],
      "properties": {
        "blue": { "$ref": "#/definitions/image" },
        "green": { "$ref": "#/definitions/image" }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/cpuMemory" },
        "limits": { "$ref": "#/definitions/cpuMemory" }
      },
      "additionalProperties": false
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 5, "maximum": 300 }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["IfNotPresent", "Always"] }
      },
      "additionalProperties": false
    },
    "cpuMemory": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
