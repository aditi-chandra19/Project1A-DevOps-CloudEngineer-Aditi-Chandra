{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source for NovaPay metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "novapay_dora_deployment_frequency{environment=\"prod\",window=\"7d\"}", "legendFormat": "Deployments / 7 days", "refId": "A" }],
      "title": "Deployment frequency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "h", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "novapay_dora_lead_time_seconds{environment=\"prod\",window=\"30d\"} / 3600", "legendFormat": "Median lead time", "refId": "A" }],
      "title": "Lead time for changes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "targets": [{ "expr": "novapay_dora_change_failure_ratio{environment=\"prod\",window=\"30d\"}", "legendFormat": "Failure ratio", "refId": "A" }],
      "title": "Change failure rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "m", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "targets": [{ "expr": "novapay_dora_time_to_restore_seconds{environment=\"prod\",window=\"30d\"} / 60", "legendFormat": "Median restore time", "refId": "A" }],
      "title": "Time to restore service",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "id": 5,
      "targets": [{ "expr": "sum(increase(novapay_ci_runs_total{result=\"success\"}[7d])) / clamp_min(sum(increase(novapay_ci_runs_total[7d])), 1)", "legendFormat": "Successful CI runs", "refId": "A" }],
      "title": "CI run success rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "id": 6,
      "targets": [{ "expr": "sum(increase(novapay_deployments_total{environment=\"prod\",result=\"success\"}[7d]))", "legendFormat": "Verified production promotions", "refId": "A" }],
      "title": "Verified production promotions (7 days)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 16 },
      "id": 7,
      "options": { "mode": "markdown", "content": "**Reporting rule:** show the selected window, event count, and data source with every DORA value. Values remain N/A until verified production release and incident records are connected. The targets are project goals, not measured results." },
      "title": "Interpretation and evidence",
      "type": "text"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["novapay", "management", "dora", "assessment", "design-only"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "NovaPay Management and DORA",
  "uid": "novapay-management-dora",
  "version": 1
}
